{
  "manifest_version": 3,
  "name": "IL Bridge Maps",
  "version": "1.0.0",
  "description": "Search Illinois NBI/IDOT bridge structure numbers and navigate to them in Google Maps.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "IL Bridge Maps",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps/*",
        "https://maps.google.com/*"
      ],
      "css": ["panel.css"],
      "js": ["lib/bridge-search.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/bridges.json"],
      "matches": [
        "https://www.google.com/*",
        "https://maps.google.com/*"
      ]
    }
  ]
}
